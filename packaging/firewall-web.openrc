#!/sbin/openrc-run

name="firewall-web"
description="Root firewall management web console"
command="/usr/bin/firewall-web"
command_args=""
command_background="yes"
pidfile="/run/firewall-web.pid"
directory="/usr/lib/firewall-web"

depend() {
	need net
}

start_pre() {
	[ "$(id -u)" -eq 0 ] || eerror "firewall-web must run as root"
	[ -r /etc/conf.d/firewall-web ] || eerror "Missing /etc/conf.d/firewall-web"
	/usr/bin/python3 /usr/lib/firewall-web/firewall-web-config.py validate \
		--config /etc/conf.d/firewall-web || eerror "Correct /etc/conf.d/firewall-web before starting."
}
