#. Type: boolean
#. description
#: ../templates:5001
msgid "Start Firewall Web after installation:"
msgstr ""

#. Type: boolean
#. description
#: ../templates:5001
msgid ""
"Start and enable the Firewall Web web console after configuration is "
"validated. Starting the console does not activate a firewall manager, change "
"firewall rules, open ports, or change firewall policies. You can change this "
"choice later with systemctl enable/disable and systemctl start/stop firewall-"
"web.service."
msgstr ""

#. Type: error
#. description
#: ../templates:6001
msgid "Invalid Firewall Web setting"
msgstr ""

#. Type: error
#. description
#: ../templates:6001
msgid ""
"The value for ${field} is invalid. Correct it and try again. Settings are "
"stored in /etc/firewall-web/firewall-web.env."
msgstr ""
