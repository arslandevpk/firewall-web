# Set your own four-digit PIN before starting. No working default PIN.
NFT_SECRET=
NFT_HOST=127.0.0.1
NFT_PORT=5005
# Exact browser-facing HTTPS origin, if using a reverse proxy:
NFT_ALLOWED_ORIGINS=
NFT_BACKUP_DIR=/var/lib/firewall-web/backups
NFT_NATIVE_STATE=/var/lib/firewall-web/native-rules.json
